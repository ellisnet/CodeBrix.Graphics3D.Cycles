<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <ApplicationId>com.codebrix.cycles.hostvalidation</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.1</ApplicationDisplayVersion>
    <ApplicationTitle>Cycles Host Validation</ApplicationTitle>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidStripNativeLibraries>false</AndroidStripNativeLibraries>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeBrixSourceRoot)/src/CodeBrix.Graphics3D.Cycles/CodeBrix.Graphics3D.Cycles.csproj" />
    <AndroidNativeLibrary Update="native/arm64-v8a/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Update="native/x86_64/*.so" Abi="x86_64" />
    <AndroidAsset Include="reference/**/*" />
    <AndroidAsset Include="notices/**/*" />
    <AndroidAsset Include="payload.json" />
  </ItemGroup>
</Project>
