<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Example client, not part of the library and never packed: loads a glTF 2.0 file with
    CodeBrix.Graphics3D.Gltf2 and renders it through the Cycles typed API.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Graphics3D.Cycles.GltfRender</AssemblyName>
    <RootNamespace>CodeBrix.Graphics3D.Cycles.GltfRender</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\CodeBrix.Graphics3D.Cycles\CodeBrix.Graphics3D.Cycles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.290.996" />
  </ItemGroup>

</Project>
