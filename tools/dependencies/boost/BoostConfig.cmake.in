@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/CodeBrixBoostTargets.cmake")
set(Boost_VERSION 1.83.0)
set(Boost_VERSION_STRING 1.83.0)
set(Boost_VERSION_MACRO 108300)
set(Boost_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set(Boost_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(Boost_LIBRARY_DIRS "${PACKAGE_PREFIX_DIR}/lib")
if(NOT TARGET Boost::headers)
  add_library(Boost::headers INTERFACE IMPORTED)
  set_target_properties(Boost::headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${Boost_INCLUDE_DIRS}")
  add_library(Boost::boost ALIAS Boost::headers)
endif()
set(Boost_LIBRARIES)
foreach(component IN LISTS Boost_FIND_COMPONENTS)
  if(TARGET Boost::${component})
    set(Boost_${component}_FOUND TRUE)
    string(TOUPPER "${component}" upper)
    set(Boost_${upper}_FOUND TRUE)
    set(Boost_${upper}_LIBRARY Boost::${component})
    list(APPEND Boost_LIBRARIES Boost::${component})
  else()
    set(Boost_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Boost)
