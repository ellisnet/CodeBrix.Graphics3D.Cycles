# ==============================================================================================
# pins.env - every pin of the Linux x64 container build (native/manylinux).
# Edit here only. build.sh sources this file, passes the values to the image build and to
# container-build.sh, and both print them at the top of every run.
# ==============================================================================================

# --- The build machine ---------------------------------------------------------------------------
# manylinux_2_28 fixes the glibc floor of everything the build links: glibc symbol versioning is
# forward-only, so a library linked on a newer glibc refuses to load on an older one. 2.28 means
# Debian 10+, Ubuntu 20.04+, RHEL 8+. The digest is the pin; the dated tag is for people.
# It is the same image, tag and digest the family's other Linux natives use.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca

# The derived image (Containerfile.x86_64): the base, labelled, with its toolchain proved.
# NOTHING is installed into it, so there is no package version or download hash to pin.
DERIVED_IMAGE_PREFIX=codebrix-cycles-build
LABEL_PREFIX=codebrix.graphics3d.cycles.build

# What the image must contain (checked by the image build and again by container-build.sh).
GCC_VERSION=14.2.1
CMAKE_VERSION=4.4.0
GLIBC_VERSION=2.28
PYTHON_IN_IMAGE=/usr/local/bin/python3.12
PYTHON_VERSION=3.12

# --- Mounts ---------------------------------------------------------------------------------------
# The checkout is mounted read-write at this FIXED path, so every path the build writes into its
# trees, and every source path compiled into a binary (__FILE__), is the same for every checkout.
CONTAINER_ROOT=/src

# The unchanged WebGPU runtime package, mounted READ-ONLY from the NuGet cache at the SAME path
# it has on the build host, so the build trees' run paths and the gates' "loaded the package's
# library" checks name the package file itself, inside and outside the container.
WEBGPU_PACKAGE_ID=codebrix.webgpu.native.mitlicenseforever
WEBGPU_PACKAGE_VERSION=1.0.300.210
WEBGPU_RUNTIME_SHA256=5a61096ef092ae3fb6638189f1ea9fe7a99350f21376f5ea1ce9b22afce35b2b

# --- Build-time tools from the checkout -----------------------------------------------------------
# ISPC (Open Image Denoise's CPU kernels; never shipped): the official release archive
# ispc-v1.30.0-linux.tar.gz unpacked into native/work/tools/ispc/ (MAINTAINER-README.txt).
# It needs glibc 2.27, so it runs in the image.
ISPC_VERSION=1.30.0
ISPC_PATH=native/work/tools/ispc/ispc-v1.30.0-linux/bin/ispc
ISPC_SHA256=cd2700a54476d590b99b0417aff37a12cfbe87cbf3c1bfcd5b4e566a96984789

# --- Checks of the result ---------------------------------------------------------------------------
# The newest GLIBC_x.y symbol version a shipped library may reference (the oldest system it loads on).
GLIBC_MAX=2.28
