+            if(!vector){let lo=min(from_min,from_max);let hi=max(from_min,from_max);factor=select(0.0,(value-lo)/(hi-lo),hi-lo!=0.0);}
+            factor=clamp(factor,0.0,1.0);factor=((factor*factor)*factor)*(factor*(factor*6.0-15.0)+10.0);
