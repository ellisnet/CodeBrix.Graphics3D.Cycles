+        let v=svm_load3(s,svm_byte(node+N_MinMax_vec_offset));
+        svm_store3(s,svm_byte(node+N_MinMax_out_offset),min(max(heap_vec3(node+N_MinMax_mn),v),heap_vec3(node+N_MinMax_mx)));return;
+    }
