Survey row 11 diagnostic (KIT-MACOS-ARM64 section 6): applied ON TOP OF row11-bvh-time-steps.patch, in a separate copy
(tree-diag), never in the survey build that rendered R2-R4. With CODEBRIX_SURVEY_CYCLES_LOG set (for example "debug") the
host sets Cycles' log level (util/log.h log_level_set; "debug" prints the BVH2 build statistics) and prints the
num_bvh_time_steps in effect to stderr. Unset, nothing changes.

SURVEY BUILD ONLY, NEVER PRODUCT CODE. Applied with `patch -p1 -d <copy>`, never to the repository.
Base: branch cycles-with-metal-v5.3.0, commit 0b19d87507ac24f1e55ba6a50d1ac6b05c8d417c.

--- a/native/host/cycles_host.cpp
+++ b/native/host/cycles_host.cpp
@@ -29,6 +29,7 @@
 #include "session/output_driver.h"
 #include "session/session.h"
 #include "util/path.h"
+#include "util/log.h"  // SURVEY DIAGNOSTIC ONLY (row 11): log_level_set
 #ifdef __APPLE__
 #  include <dlfcn.h>
 #  include <sys/sysctl.h>
@@ -614,6 +615,12 @@
     scene.use_bvh_unaligned_nodes = true; scene.use_texture_cache = false;
     // SURVEY BUILD ONLY (KIT-MACOS-ARM64 row 11): BVH time steps from the environment; unset keeps Cycles' default 0.
     if (const char *steps = std::getenv("CODEBRIX_SURVEY_BVH_TIME_STEPS")) scene.num_bvh_time_steps = std::atoi(steps);
+    // SURVEY DIAGNOSTIC ONLY (KIT-MACOS-ARM64 row 11): Cycles' log level from the environment ("debug" prints the BVH2
+    // build statistics to stdout) and the time steps in effect, so that the survey can show the setting reached Cycles.
+    if (const char *level = std::getenv("CODEBRIX_SURVEY_CYCLES_LOG")) {
+      ccl::log_level_set(std::string(level));
+      std::fprintf(stderr, "survey diagnostic: SceneParams::num_bvh_time_steps = %d\n", scene.num_bvh_time_steps);
+    }
     host->session = std::make_unique<Session>(params, scene);
     require(!host->session->progress.get_error(), host->session->progress.get_error_message().c_str(), CBC_FAILED);
     require(host->session->device->info.type == type, "Device selection changed unexpectedly", CBC_FAILED);
